# Application
APP_ENV=development

# GitHub
GITHUB_TOKEN=

# JWT Authentication
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL (docker compose defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mcp_gateway
POSTGRES_USER=mcp_user
POSTGRES_PASSWORD=mcp_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Research project search (enterprise-hybrid-rag running on port 8001)
RAG_API_URL=http://127.0.0.1:8001

# Agent LLM: OpenAI, or any OpenAI-compatible endpoint (vLLM, Ollama)
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
# LLM_BASE_URL=http://localhost:11434/v1
GATEWAY_URL=http://127.0.0.1:8000
AGENT_MAX_STEPS=8

# A2A server
A2A_URL=http://127.0.0.1:9000

# Langfuse tracing (optional, agent runs untraced without keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
